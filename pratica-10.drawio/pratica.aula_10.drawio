        <mxCell id="rh4tWCF5fXv3vGWnebjI-8" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; font-family: &amp;quot;Google Sans&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Quadro 3. Evolução das Formas Normais&lt;/h3&gt;&lt;table style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 255, 255); font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; margin-bottom: 32px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;thead style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;tr style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin: 0px !important;&quot;&gt;Forma Normal&lt;/strong&gt;&lt;/td&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;strong style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin: 0px !important;&quot;&gt;O que mudou&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;tr style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;1FN&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Garantia de atomicidade:&lt;/b&gt; Remoção dos campos multivalorados (&lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;produtos&lt;/code&gt;, &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;qtd&lt;/code&gt;, &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;preços&lt;/code&gt; separados por ponto e vírgula &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;;&lt;/code&gt;). Cada linha passou a conter apenas um produto por pedido.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;2FN&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Eliminação de dependências parciais:&lt;/b&gt; Separação entre dados do pedido e itens do pedido. Atributos como &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;data_hora&lt;/code&gt;, &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;unidade&lt;/code&gt;, &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;telefone_cliente&lt;/code&gt; e &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;entregador&lt;/code&gt; dependem apenas da chave &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;pedido&lt;/code&gt;, não da chave composta &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;(pedido + produto)&lt;/code&gt;.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;3FN&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;forced-color-adjust: none; box-shadow: none !important; border: 1px solid light-dark(rgb(196, 199, 197), rgb(65, 68, 66)); padding: 8px 12px; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Eliminação de dependências transitivas e atributos derivados:&lt;/b&gt; Remoção da coluna &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;total&lt;/code&gt; (dado calculado) e criação da tabela &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Unidade&lt;/code&gt;, pois &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;endereço_unidade&lt;/code&gt; dependia de &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;unidade&lt;/code&gt; (atributo não-chave) e não diretamente do &lt;code style=&quot;forced-color-adjust: none; box-shadow: none !important; font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;pedido&lt;/code&gt;.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="280" width="560" x="60" y="830" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
